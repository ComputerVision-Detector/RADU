# Default to CPU; set gpu:0 only when a compatible NVIDIA driver is available.
RADU_PADDLE_DEVICE=cpu
RADU_PADDLE_VL_ENGINE=paddle

# PaddleX model cache defaults to .cache/paddlex in this project.
# PADDLE_PDX_CACHE_HOME=/path/to/writable/paddlex-cache

# CLOVA is implemented but held out of the default benchmark due to API cost.
# CLOVA_OCR_INVOKE_URL=
# CLOVA_OCR_SECRET=
